{
  "info": {
    "_postman_id": "pks-education-api-collection-v1",
    "name": "PKS Education Portal API",
    "description": "Complete API collection for PKSEducation project.\n\n**Base URL:** `http://localhost:3000`\n\n**Authentication:** Bearer Token (JWT)\n\n**Seed Accounts:**\n- Admin: `admin@pks.edu.vn` / `Admin@123`\n- Student: `student@pks.edu.vn` / `Student@123`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "Auto-set after Admin Login"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string",
      "description": "Auto-set after Student Login"
    },
    {
      "key": "courseId",
      "value": "",
      "type": "string",
      "description": "Auto-set after Create Course"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "description": "Authentication endpoints: Register, Login, Profile.",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van B\",\n  \"email\": \"newstudent@pks.edu.vn\",\n  \"password\": \"Student@123\"\n}"
            },
            "description": "Register a new student account. Role is automatically set to STUDENT."
          },
          "response": [
            {
              "name": "201 - Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"message\": \"Create account success\",\n  \"user\": {\n    \"id\": \"clxyz...\",\n    \"fullName\": \"Nguyen Van B\",\n    \"email\": \"newstudent@pks.edu.vn\",\n    \"role\": \"STUDENT\",\n    \"createdAt\": \"2026-09-29T10:00:00.000Z\",\n    \"updatedAt\": \"2026-09-29T10:00:00.000Z\"\n  }\n}"
            },
            {
              "name": "409 - Email Already Exists",
              "status": "Conflict",
              "code": 409,
              "body": "{\n  \"statusCode\": 409,\n  \"message\": \"Email used\",\n  \"error\": \"Conflict\"\n}"
            },
            {
              "name": "400 - Validation Error (missing fields)",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"statusCode\": 400,\n  \"message\": [\"fullName should not be empty\", \"email must be an email\"],\n  \"error\": \"Bad Request\"\n}"
            }
          ]
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('adminToken', json.accessToken);",
                  "  console.log('✅ Admin token saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@pks.edu.vn\",\n  \"password\": \"Admin@123\"\n}"
            },
            "description": "Login as Admin. The test script auto-saves `adminToken` to collection variables."
          },
          "response": [
            {
              "name": "200 - Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": \"clxyz...\",\n    \"fullName\": \"Admin PKS\",\n    \"email\": \"admin@pks.edu.vn\",\n    \"role\": \"ADMIN\"\n  }\n}"
            },
            {
              "name": "401 - Wrong Password",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"statusCode\": 401,\n  \"message\": \"Pass is incorrect\",\n  \"error\": \"Unauthorized\"\n}"
            },
            {
              "name": "401 - Email Not Found",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"statusCode\": 401,\n  \"message\": \"Email is incorrect\",\n  \"error\": \"Unauthorized\"\n}"
            }
          ]
        },
        {
          "name": "Login Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('studentToken', json.accessToken);",
                  "  console.log('✅ Student token saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@pks.edu.vn\",\n  \"password\": \"Student@123\"\n}"
            },
            "description": "Login as Student. The test script auto-saves `studentToken` to collection variables."
          },
          "response": [
            {
              "name": "200 - Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": \"clxyz...\",\n    \"fullName\": \"Student PKS\",\n    \"email\": \"student@pks.edu.vn\",\n    \"role\": \"STUDENT\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Get Profile (Auth Required)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] },
            "description": "Get currently authenticated user's profile. Requires a valid JWT."
          },
          "response": [
            {
              "name": "200 - Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"id\": \"clxyz...\",\n  \"fullName\": \"Student PKS\",\n  \"email\": \"student@pks.edu.vn\",\n  \"role\": \"STUDENT\",\n  \"createdAt\": \"2026-09-29T10:00:00.000Z\"\n}"
            },
            {
              "name": "401 - No Token",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"statusCode\": 401,\n  \"message\": \"Unauthorized\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "📚 Courses",
      "description": "Course CRUD endpoints. GET endpoints are public. POST/PATCH/DELETE require Admin or Staff role.",
      "item": [
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/courses?search=&category=",
              "host": ["{{baseUrl}}"],
              "path": ["courses"],
              "query": [
                { "key": "search", "value": "", "description": "Search by title, instructor, or description" },
                { "key": "category", "value": "", "description": "Filter by exact category name (case-insensitive)" }
              ]
            },
            "description": "Retrieve all visible courses. Supports `search` and `category` query filters.\n\n- Without token: returns only non-hidden courses.\n- With Admin/Staff token: returns all courses including hidden ones."
          },
          "response": [
            {
              "name": "200 - Success (list)",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"id\": \"clxyz...\",\n    \"title\": \"Lập trình NestJS\",\n    \"category\": \"Backend\",\n    \"instructor\": \"GV Nguyễn Văn A\",\n    \"shortDescription\": \"Từ cơ bản đến nâng cao\",\n    \"fee\": 2500000,\n    \"maxCapacity\": 30,\n    \"enrolledCount\": 10,\n    \"isHidden\": false,\n    \"isFull\": false\n  }\n]"
            },
            {
              "name": "200 - Filtered by category",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"id\": \"clxyz...\",\n    \"title\": \"Lập trình NestJS\",\n    \"category\": \"Backend\",\n    \"isFull\": false\n  }\n]"
            }
          ]
        },
        {
          "name": "Get Course Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/courses/{{courseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["courses", "{{courseId}}"]
            },
            "description": "Get details of a specific course by ID."
          },
          "response": [
            {
              "name": "200 - Found",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"id\": \"clxyz...\",\n  \"title\": \"Lập trình NestJS\",\n  \"category\": \"Backend\",\n  \"instructor\": \"GV Nguyễn Văn A\",\n  \"shortDescription\": \"Từ cơ bản đến nâng cao\",\n  \"fullDescription\": \"Nội dung chi tiết...\",\n  \"fee\": 2500000,\n  \"maxCapacity\": 30,\n  \"enrolledCount\": 10,\n  \"isHidden\": false,\n  \"isFull\": false\n}"
            },
            {
              "name": "404 - Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"statusCode\": 404,\n  \"message\": \"Course is not found\",\n  \"error\": \"Not Found\"\n}"
            }
          ]
        },
        {
          "name": "Create Course (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('courseId', json.id);",
                  "  console.log('✅ courseId saved: ' + json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/courses", "host": ["{{baseUrl}}"], "path": ["courses"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lập trình React nâng cao\",\n  \"category\": \"Frontend\",\n  \"instructor\": \"GV Trần Thị B\",\n  \"shortDescription\": \"React hooks, context, performance optimization\",\n  \"fullDescription\": \"Khóa học chuyên sâu về React 19 với các patterns hiện đại.\",\n  \"fee\": 3000000,\n  \"maxCapacity\": 25\n}"
            },
            "description": "Create a new course. Requires **Admin** or **Staff** role. The test script auto-saves `courseId`."
          },
          "response": [
            {
              "name": "201 - Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"id\": \"clnew...\",\n  \"title\": \"Lập trình React nâng cao\",\n  \"category\": \"Frontend\",\n  \"instructor\": \"GV Trần Thị B\",\n  \"fee\": 3000000,\n  \"maxCapacity\": 25,\n  \"enrolledCount\": 0,\n  \"isHidden\": false\n}"
            },
            {
              "name": "401 - No Token",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"statusCode\": 401,\n  \"message\": \"Unauthorized\"\n}"
            },
            {
              "name": "403 - Student Role Forbidden",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"statusCode\": 403,\n  \"message\": \"Not authorizied\",\n  \"error\": \"Forbidden\"\n}"
            }
          ]
        },
        {
          "name": "Update Course (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/{{courseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["courses", "{{courseId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fee\": 3500000,\n  \"maxCapacity\": 40,\n  \"isHidden\": false\n}"
            },
            "description": "Update course details (partial update). Requires **Admin** or **Staff** role."
          },
          "response": [
            {
              "name": "200 - Updated",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"id\": \"clxyz...\",\n  \"title\": \"Lập trình React nâng cao\",\n  \"fee\": 3500000,\n  \"maxCapacity\": 40,\n  \"isHidden\": false\n}"
            },
            {
              "name": "400 - maxCapacity < enrolledCount",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"statusCode\": 400,\n  \"message\": \"Max capacity must be greater than or equal to enrolled count\",\n  \"error\": \"Bad Request\"\n}"
            },
            {
              "name": "404 - Course Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"statusCode\": 404,\n  \"message\": \"Course is not found\",\n  \"error\": \"Not Found\"\n}"
            },
            {
              "name": "403 - Forbidden (Student role)",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"statusCode\": 403,\n  \"message\": \"Not authorizied\",\n  \"error\": \"Forbidden\"\n}"
            }
          ]
        },
        {
          "name": "Delete Course (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/courses/{{courseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["courses", "{{courseId}}"]
            },
            "description": "Permanently delete a course. Requires **Admin** or **Staff** role."
          },
          "response": [
            {
              "name": "200 - Deleted",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"id\": \"clxyz...\",\n  \"title\": \"Lập trình React nâng cao\"\n}"
            },
            {
              "name": "404 - Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"statusCode\": 404,\n  \"message\": \"Course is not found\",\n  \"error\": \"Not Found\"\n}"
            },
            {
              "name": "403 - Forbidden",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"statusCode\": 403,\n  \"message\": \"Not authorizied\",\n  \"error\": \"Forbidden\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "🎓 Enrollments",
      "description": "Enrollment endpoints. Students enroll/view their courses. Admins view enrollments per course.",
      "item": [
        {
          "name": "Enroll in Course (Student)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/enrollments", "host": ["{{baseUrl}}"], "path": ["enrollments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"{{courseId}}\"\n}"
            },
            "description": "Student enrolls in a course. Uses atomic `updateMany` with capacity guard to prevent race conditions."
          },
          "response": [
            {
              "name": "201 - Enrolled Successfully",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"message\": \"Successfully enrolled in the course!\",\n  \"enrollment\": {\n    \"id\": \"enr-001\",\n    \"userId\": \"user-abc\",\n    \"courseId\": \"course-xyz\",\n    \"status\": \"CONFIRMED\",\n    \"enrolledAt\": \"2026-09-29T13:00:00.000Z\",\n    \"course\": {\n      \"id\": \"course-xyz\",\n      \"title\": \"Lập trình NestJS\",\n      \"category\": \"Backend\",\n      \"instructor\": \"GV Nguyễn Văn A\",\n      \"fee\": 2500000\n    }\n  }\n}"
            },
            {
              "name": "409 - Already Enrolled",
              "status": "Conflict",
              "code": 409,
              "body": "{\n  \"statusCode\": 409,\n  \"message\": \"You already enrolled in this course.\",\n  \"error\": \"Conflict\"\n}"
            },
            {
              "name": "400 - Course Is Full",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"statusCode\": 400,\n  \"message\": \"Course is already full!\",\n  \"error\": \"Bad Request\"\n}"
            },
            {
              "name": "400 - Course Is Hidden",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"statusCode\": 400,\n  \"message\": \"You cannot enroll in a hidden course.\",\n  \"error\": \"Bad Request\"\n}"
            },
            {
              "name": "401 - No Token",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"statusCode\": 401,\n  \"message\": \"Unauthorized\"\n}"
            },
            {
              "name": "404 - Course Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"statusCode\": 404,\n  \"message\": \"Course with id \\\"invalid-id\\\" is not found!\",\n  \"error\": \"Not Found\"\n}"
            }
          ]
        },
        {
          "name": "Get My Enrolled Courses (Student)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/enrollments/my-courses",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments", "my-courses"]
            },
            "description": "Returns the list of courses the authenticated student has enrolled in."
          },
          "response": [
            {
              "name": "200 - Success",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"id\": \"enr-001\",\n    \"status\": \"CONFIRMED\",\n    \"enrolledAt\": \"2026-09-29\",\n    \"course\": {\n      \"id\": \"course-xyz\",\n      \"title\": \"Lập trình NestJS\",\n      \"category\": \"Backend\",\n      \"instructor\": \"GV Nguyễn Văn A\",\n      \"fee\": 2500000,\n      \"maxCapacity\": 30,\n      \"enrolledCount\": 11\n    }\n  }\n]"
            },
            {
              "name": "401 - No Token / Invalid Token",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"statusCode\": 401,\n  \"message\": \"Unauthorized\"\n}"
            }
          ]
        },
        {
          "name": "Get Course Enrollments (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/enrollments/course/{{courseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments", "course", "{{courseId}}"]
            },
            "description": "Get all students enrolled in a specific course. Requires **Admin** or **Staff** role."
          },
          "response": [
            {
              "name": "200 - Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"courseId\": \"course-xyz\",\n  \"courseTitle\": \"Lập trình NestJS\",\n  \"maxCapacity\": 30,\n  \"enrolledCount\": 11,\n  \"students\": [\n    {\n      \"enrollmentId\": \"enr-001\",\n      \"studentId\": \"user-abc\",\n      \"fullName\": \"Student PKS\",\n      \"email\": \"student@pks.edu.vn\",\n      \"status\": \"CONFIRMED\",\n      \"enrolledAt\": \"2026-09-29\"\n    }\n  ]\n}"
            },
            {
              "name": "403 - Student Role Forbidden",
              "status": "Forbidden",
              "code": 403,
              "body": "{\n  \"statusCode\": 403,\n  \"message\": \"Not authorizied\",\n  \"error\": \"Forbidden\"\n}"
            },
            {
              "name": "404 - Course Not Found",
              "status": "Not Found",
              "code": 404,
              "body": "{\n  \"statusCode\": 404,\n  \"message\": \"Course with id \\\"invalid-id\\\" not found.\",\n  \"error\": \"Not Found\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
